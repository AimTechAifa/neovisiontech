# Public origin for canonicals, Open Graph, sitemap, robots, and JSON-LD.
# Leave unset to use https://$VERCEL_PROJECT_PRODUCTION_URL, then https://neovisiontech.vercel.app.
# Set this only after that hostname serves this deployment.
# https://neovisiontech.com currently points at an unrelated server and must not be used yet.
# NEXT_PUBLIC_SITE_URL=https://neovisiontech.vercel.app

# Postgres connection string. When unset, the site builds and serves seeded content
# from src/content with no database.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/neovision

# Server-side Groq key for the assessment quiz and learning roadmap.
# Never expose this to the browser. Leave unset to use the built-in fallback quiz.
GROQ_API_KEY=

# Optional email delivery for contact leads. When unset, leads are stored
# (if DATABASE_URL is set) and the form still confirms without sending mail.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@neovisiontech.in
CONTACT_FROM_EMAIL=NeoVision Tech <onboarding@resend.dev>
